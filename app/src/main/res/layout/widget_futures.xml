<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_futures_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_futures_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="24/7 Overnight Futures"
        android:textColor="#00C805"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_futures_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:text="ES 6,012 (+0.44%) • NQ 21,084 (+0.72%)\nYM 44,015 (+0.24%) • RTY 2,378 • VX 15.45"
        android:textColor="#F5F7FA"
        android:textSize="12sp" />
</LinearLayout>
